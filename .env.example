# Copiar a .env y ajustar. Todas tienen un valor por defecto en docker-compose.yml,
# asi que .env es opcional para docker compose up.

# Credenciales de MySQL (las usan el contenedor mysql y la API)
DB_DATABASE=pretrabajo
DB_USERNAME=app
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# Puertos publicados en el host
WEB_PORT=3001
API_PORT=3000
DB_PORT=3306

# Solo para correr la API fuera de Docker (npm run start:dev dentro de /api).
# Dentro de Docker compose fija DB_HOST=mysql y PORT=3000.
DB_HOST=localhost
PORT=3000

# Base para npm run test:int. Se borra y recrea en cada ejecucion: debe terminar en _test
DB_TEST_DATABASE=pretrabajo_test
